{
  "name": "gazeta-astro-theme",
  "description": "A classic Astro newspaper and magazine theme for editorial publishers.",
  "type": "module",
  "version": "2.0.0",
  "author": "Andrei Alba",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "magazine",
    "blog",
    "entertainment",
    "tailwindcss"
  ],
  "homepage": "https://gazeta.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/gazeta.git"
  },
  "engines": {

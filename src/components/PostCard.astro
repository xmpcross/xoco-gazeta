---
import { Image } from "astro:assets";
import Avatar from "@/components/Avatar.astro";
import CategoryTag from "@/components/CategoryTag.astro";
import { formatDate, postHref, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  variant?: "hero" | "feature" | "lead" | "medium" | "horizontal" | "split" | "compact" | "overlay";
  eager?: boolean;
  /* Hides the category label, for lists that already sit under a section heading. */
  hideCategory?: boolean;
}

const { post, variant = "medium", eager = false, hideCategory = false } = Astro.props;
const href = postHref(post);
const data = post.data;
const image = data.cover;
const date = formatDate(data.date);
const datetime = data.date.toISOString();
const imageLoading = eager ? "eager" : "lazy";
---

{
  variant === "hero" && (
    <a href={href} class="group block">
      <div class="media aspect-[16/10]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1200, 1600]}
          sizes="(min-width: 1344px) 860px, (min-width: 1024px) 64vw, 100vw"
          loading={imageLoading}
          fetchpriority={eager ? "high" : undefined}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="pt-6">
        {!hideCategory && <CategoryTag category={data.category} variant="pill" />}
        <h2 class="headline mt-4 text-[clamp(2rem,4.2vw,3.5rem)] leading-[1.04]">
          <span class="card-title">{data.title}</span>
        </h2>
        <p class="mt-4 max-w-3xl text-pretty text-[1.0625rem] leading-relaxed text-muted-foreground md:text-lg">
          {data.excerpt}
        </p>
        <div class="mt-5 flex items-center gap-3">
          <Avatar name={data.author.name} size={32} loading={imageLoading} />
          <p class="meta">
            <span class="font-medium text-foreground">{data.author.name}</span>
            <span aria-hidden="true"> · </span>
            <time datetime={datetime}>{date}</time>
            <span aria-hidden="true"> · </span>
            {data.readMinutes} min read
          </p>
        </div>
      </div>
    </a>
  )
}

{
  variant === "lead" && (
    <a href={href} class="group block">
      <div class="media aspect-[3/2]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="pt-5">
        {!hideCategory && <CategoryTag category={data.category} />}
        <h3 class="headline mt-2.5 text-[1.65rem] leading-[1.12] md:text-[1.9rem]">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="mt-3 text-pretty leading-relaxed text-muted-foreground">{data.excerpt}</p>
        <div class="mt-4 flex items-center gap-2.5">
          <Avatar name={data.author.name} size={28} />
          <p class="meta">
            <span class="font-medium text-foreground">{data.author.name}</span>
            <span aria-hidden="true"> · </span>
            <time datetime={datetime}>{date}</time>
          </p>
        </div>
      </div>
    </a>
  )
}

{
  variant === "feature" && (
    <a href={href} class="group grid items-center gap-6 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-10">
      <div class="media aspect-[3/2]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1344px) 720px, (min-width: 768px) 55vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div>
        {!hideCategory && <CategoryTag category={data.category} variant="pill" />}
        <h3 class="headline mt-3 text-[clamp(1.75rem,3vw,2.6rem)] leading-[1.08]">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="mt-4 text-pretty leading-relaxed text-muted-foreground md:text-[1.0625rem]">{data.excerpt}</p>
        <div class="mt-5 flex items-center gap-3">
          <Avatar name={data.author.name} size={32} />
          <p class="meta">
            <span class="font-medium text-foreground">{data.author.name}</span>
            <span aria-hidden="true"> · </span>
            <time datetime={datetime}>{date}</time>
            <span aria-hidden="true"> · </span>
            {data.readMinutes} min read
          </p>
        </div>
      </div>
    </a>
  )
}

{
  variant === "medium" && (
    <a href={href} class="group block">
      <div class="media aspect-[3/2]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="pt-4">
        {!hideCategory && <CategoryTag category={data.category} />}
        <h3 class="headline mt-2 text-[1.2rem] leading-snug md:text-[1.3rem]">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="meta mt-2.5">
          <time datetime={datetime}>{date}</time>
          <span aria-hidden="true"> · </span>
          {data.readMinutes} min read
        </p>
      </div>
    </a>
  )
}

{
  variant === "horizontal" && (
    <a href={href} class="group grid grid-cols-[minmax(0,1fr)_6rem] items-start gap-4 py-3 sm:grid-cols-[minmax(0,1fr)_7rem]">
      <div class="min-w-0">
        {!hideCategory && <CategoryTag category={data.category} />}
        <h3 class="headline mt-1.5 text-[1.05rem] leading-snug">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="meta mt-1.5">
          <time datetime={datetime}>{date}</time>
        </p>
      </div>
      <div class="media aspect-square">
        <Image
          src={image.src}
          alt={image.alt}
          width={224}
          height={224}
          densities={[1, 2]}
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </a>
  )
}

{
  variant === "split" && (
    <a href={href} class="group grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] items-center gap-5 sm:gap-6">
      <div class="media aspect-[4/3]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[320, 480, 720]}
          sizes="(min-width: 1344px) 290px, (min-width: 768px) 22vw, 45vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="min-w-0">
        {!hideCategory && <CategoryTag category={data.category} />}
        <h3 class="headline text-[1.15rem] leading-snug sm:text-[1.35rem]">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="mt-2 hidden text-pretty text-[0.9375rem] leading-relaxed text-muted-foreground sm:line-clamp-2">
          {data.excerpt}
        </p>
        <p class="meta mt-3">
          <time datetime={datetime}>{date}</time>
          <span aria-hidden="true"> · </span>
          {data.readMinutes} min read
        </p>
      </div>
    </a>
  )
}

{
  variant === "compact" && (
    <a href={href} class="group block py-3.5">
      <span class="headline block text-[1.08rem] leading-snug">
        <span class="card-title">{data.title}</span>
      </span>
      <span class="meta mt-1.5 block">
        <time datetime={datetime}>{date}</time>
        <span aria-hidden="true"> · </span>
        {data.readMinutes} min read
      </span>
    </a>
  )
}

{
  variant === "overlay" && (
    <a href={href} class="group relative block">
      <div class="media aspect-[4/5] sm:aspect-[3/4]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="absolute inset-0 flex flex-col justify-end rounded-media bg-linear-to-t from-black/85 via-black/25 to-transparent p-5 text-white">
        {!hideCategory && (
          <span class="text-[0.8125rem] font-semibold text-white/80">{data.category}</span>
        )}
        <h3 class="headline mt-1.5 text-[1.35rem] leading-tight">
          <span class="card-title">{data.title}</span>
        </h3>
        <p class="mt-2 text-[0.8125rem] text-white/75">
          {data.author.name}
          <span aria-hidden="true"> · </span>
          {data.readMinutes} min read
        </p>
      </div>
    </a>
  )
}

---
import { Image } from "astro:assets";
import PostHeroHead from "@/components/PostHeroHead.astro";
import { type Post } from "@/lib/posts";

interface Props {
  post: Post;
  /* Absolute URL of the story. */
  url: string;
}

const { post, url } = Astro.props;
const data = post.data;
const layout = data.heroLayout;
const widths = [640, 960, 1200, 1600, 2000];
---

{
  layout === "standard" && (
    <header>
      <div class="mx-auto max-w-[52rem] px-5 pt-10 md:pt-14">
        <PostHeroHead post={post} url={url} />
      </div>
      <figure class="mx-auto mt-10 max-w-[76rem] px-5 md:mt-12 lg:px-8">
        <div class="media aspect-[16/9] md:aspect-[2/1]">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            widths={widths}
            sizes="(min-width: 1216px) 1152px, calc(100vw - 2.5rem)"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
            data-zoomable
          />
        </div>
        <figcaption class="meta mt-3 text-right">
          Photo: <a href={data.cover.creditUrl} rel="noreferrer" class="story-link">{data.cover.creditName}</a>
        </figcaption>
      </figure>
    </header>
  )
}

{
  layout === "banner" && (
    <header>
      <figure class="mx-auto max-w-[76rem] px-5 pt-6 lg:px-8">
        <div class="media aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            widths={widths}
            sizes="(min-width: 1216px) 1152px, calc(100vw - 2.5rem)"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
            data-zoomable
          />
        </div>
        <figcaption class="meta mt-3 text-right">
          Photo: <a href={data.cover.creditUrl} rel="noreferrer" class="story-link">{data.cover.creditName}</a>
        </figcaption>
      </figure>
      <div class="mx-auto max-w-[52rem] px-5 pt-8 md:pt-10">
        <PostHeroHead post={post} url={url} />
      </div>
    </header>
  )
}

{
  layout === "cover" && (
    <header class="mx-auto max-w-[76rem] px-5 pt-6 lg:px-8">
      <div class="relative isolate grid min-h-[34rem] items-end overflow-hidden rounded-[1.25rem] md:min-h-[40rem]">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={widths}
          sizes="(min-width: 1216px) 1152px, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/45 to-black/5" aria-hidden="true" />
        <div class="mx-auto max-w-[52rem] px-5 pb-10 pt-24 md:pb-14">
          <PostHeroHead post={post} url={url} tone="light" />
          <p class="mt-6 text-center text-[0.8125rem] text-white/65">
            Photo: <a href={data.cover.creditUrl} rel="noreferrer" class="story-link">{data.cover.creditName}</a>
          </p>
        </div>
      </div>
    </header>
  )
}

{
  layout === "immersive" && (
    <header class="relative isolate grid min-h-[100svh] items-end overflow-hidden">
      <Image
        src={data.cover.src}
        alt={data.cover.alt}
        widths={[960, 1440, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/35 to-black/55" aria-hidden="true" />
      <div class="mx-auto w-full max-w-[52rem] px-5 pb-12 pt-56 md:pb-16">
        <PostHeroHead post={post} url={url} tone="light" />
        <p class="mt-6 text-center text-[0.8125rem] text-white/65">
          Photo: <a href={data.cover.creditUrl} rel="noreferrer" class="story-link">{data.cover.creditName}</a>
        </p>
      </div>
    </header>
  )
}

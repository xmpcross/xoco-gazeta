---
import { siteConfig } from "@/config/site";
import { searchItem, visiblePosts, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const posts = visiblePosts(Astro.props.posts);
/* Inlined so the palette still returns results if /search-index.json fails. */
const fallback = posts.slice(0, 12).map(searchItem);
---

<dialog
  id="site-search-dialog"
  class="search-dialog"
  aria-labelledby="site-search-title"
  aria-describedby="site-search-summary"
  data-search-dialog
>
  <div class="search-panel" data-search-panel data-empty>
    <form action="/search/" method="get" role="search" aria-label="Site search">
      <div class="search-field">
        <svg aria-hidden="true" class="search-field__icon" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75"></circle>
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
          ></path>
        </svg>
        <h2 id="site-search-title" class="sr-only">Search {siteConfig.name}</h2>
        <label class="sr-only" for="site-search-input">Search stories</label>
        <input
          id="site-search-input"
          name="q"
          type="search"
          class="search-input"
          placeholder="Search stories, sections, topics, reporters…"
          autocomplete="off"
          enterkeyhint="search"
          data-search-input
        />
        <button type="button" class="icon-btn" aria-label="Close search" data-search-close>
          <svg aria-hidden="true" class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="none">
            <path
              d="m6 6 12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <div class="search-body">
        <p
          id="site-search-summary"
          class="search-body__head text-xs text-muted-foreground"
          data-search-summary
          aria-live="polite"
        >
        </p>
        <div class="search-results" data-search-results></div>
      </div>

      <div class="search-foot" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
        <span><kbd data-search-shortcut>Ctrl K</kbd> Toggle</span>
        <span class="ml-auto hidden sm:inline">Enter searches everything</span>
      </div>
    </form>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  id="site-search-fallback"
  set:html={JSON.stringify(fallback)}
/>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-search-dialog]");
    if (!dialog) return;

    const triggers = document.querySelectorAll("[data-search-open]");
    const closeButton = dialog.querySelector("[data-search-close]");
    const shortcutKey = dialog.querySelector("[data-search-shortcut]");
    const input = dialog.querySelector("[data-search-input]");
    const results = dialog.querySelector("[data-search-results]");
    const summary = dialog.querySelector("[data-search-summary]");
    const panel = dialog.querySelector("[data-search-panel]");
    const fallback = JSON.parse(
      document.getElementById("site-search-fallback")?.textContent || "[]",
    );
    let index = [];
    let indexPromise;
    let lastTrigger = null;

    if (shortcutKey && /Mac|iPhone|iPad/.test(navigator.userAgent)) {
      shortcutKey.textContent = "⌘ K";
    }

    /* The full index is fetched on first open, so the palette costs nothing on
       pages the reader never searches from. */
    const loadIndex = () => {
      if (index.length > 0) return Promise.resolve(index);

      indexPromise ??= fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error("Search index unavailable");
          return response.json();
        })
        .then((items) => {
          index = Array.isArray(items) && items.length > 0 ? items : fallback;
          return index;
        })
        .catch(() => {
          index = fallback;
          return index;
        });

      return indexPromise;
    };

    const escapeHtml = (value) =>
      String(value).replace(
        /[&<>"']/g,
        (character) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[character],
      );

    /* Lower is better: an exact title prefix beats a title match, which beats
       a section, then a tag, then a hit in the excerpt or byline. */
    const rank = (item, query) => {
      const title = item.title.toLowerCase();
      const category = (item.category || "").toLowerCase();
      const tags = (item.tags || []).join(" ").toLowerCase();
      const supporting = [item.excerpt, item.author].join(" ").toLowerCase();

      if (title.startsWith(query)) return 0;
      if (title.includes(query)) return 1;
      if (category.includes(query)) return 2;
      if (tags.includes(query)) return 3;
      if (supporting.includes(query)) return 4;
      return Number.POSITIVE_INFINITY;
    };

    const resultMarkup = (item) => `
      <a href="${escapeHtml(item.href)}" class="search-result">
        <span class="search-result__title">${escapeHtml(item.title)}</span>
        <span class="search-result__meta">${escapeHtml(item.category || "")} &middot; ${escapeHtml(item.date)} &middot; ${escapeHtml(item.reading || "")}</span>
      </a>
    `;

    const render = async () => {
      if (!input || !results || !summary) return;

      const raw = input.value.trim();
      const query = raw.toLowerCase();

      /* Until the reader types, the palette collapses to just the input. */
      if (!query) {
        panel?.setAttribute("data-empty", "");
        summary.textContent = "";
        results.innerHTML = "";
        return;
      }

      panel?.removeAttribute("data-empty");

      const items = await loadIndex();

      /* A newer keystroke may have landed while the index was loading. */
      if (input.value.trim().toLowerCase() !== query) return;

      const matches = items
        .map((item) => ({ item, score: rank(item, query) }))
        .filter(({ score }) => Number.isFinite(score))
        .sort((a, b) => a.score - b.score)
        .slice(0, 7)
        .map(({ item }) => item);

      summary.textContent = `${matches.length} ${matches.length === 1 ? "result" : "results"} for “${raw}”.`;
      results.innerHTML =
        matches.length > 0
          ? matches.map(resultMarkup).join("")
          : `<p class="search-empty">Nothing matches that yet. Try a headline, section, or reporter.</p>`;
    };

    const open = (trigger) => {
      if (!input || typeof dialog.showModal !== "function") return;

      lastTrigger = trigger ?? null;
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add("has-open-search");
      void render();
      window.requestAnimationFrame(() => input.focus());
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        if (typeof dialog.showModal !== "function") return;
        /* Without <dialog> support the trigger stays a plain link to /search/. */
        event.preventDefault();
        open(trigger);
      });
    });

    closeButton?.addEventListener("click", close);

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-search");
      /* Focus goes back to whatever opened the palette, unless that control
         has since been hidden with the drawer. */
      if (lastTrigger?.isConnected && lastTrigger.offsetParent !== null) lastTrigger.focus();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    input?.addEventListener("input", () => void render());

    input?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      const first = results?.querySelector("a");
      if (!first) return;
      event.preventDefault();
      first.focus();
    });

    results?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

      const links = Array.from(results.querySelectorAll("a"));
      const current = links.indexOf(document.activeElement);
      if (current === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") (links[current + 1] || links[0])?.focus();
      else if (current === 0) input?.focus();
      else links[current - 1]?.focus();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isEditing =
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable);
      const isCommandShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      const isSlashShortcut =
        event.key === "/" && !isEditing && !event.metaKey && !event.ctrlKey && !event.altKey;

      if (!isCommandShortcut && !isSlashShortcut) return;
      event.preventDefault();

      if (dialog.open && isCommandShortcut) close();
      else open(null);
    });
  })();
</script>

<style>
  .search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    overflow-y: auto;
    border: 0;
    background: transparent;
    color: var(--foreground);
    padding: clamp(0.75rem, 9vh, 5rem) 1rem 1rem;
  }

  .search-dialog[open] {
    display: grid;
    grid-template-columns: minmax(0, 40rem);
    align-items: start;
    justify-content: center;
  }

  .search-dialog::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-panel {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 1.25rem;
    box-shadow: 0 28px 70px oklch(0 0 0 / 24%);
  }

  .search-dialog[open] .search-panel {
    animation: search-in 180ms var(--ease-out);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding: 0 1rem;
    transition: border-color 0.28s var(--ease-out);
  }

  .search-field__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    color: var(--muted-foreground);
  }

  .search-input {
    width: 100%;
    min-width: 0;
    height: 4rem;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--foreground);
    outline: none;
    padding: 0;
    font: inherit;
    font-size: 1.0625rem;
  }

  .search-input::placeholder {
    color: var(--muted-foreground);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .search-body {
    max-height: min(58vh, 28rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.85rem;
  }

  /* Before the first keystroke the palette is just the input and the shortcut
     hints, so it stays as small as possible. */
  .search-panel[data-empty] .search-body {
    display: none;
  }

  .search-panel[data-empty] .search-field {
    border-bottom-color: transparent;
  }

  .search-body__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.35rem 0.6rem;
  }

  .search-results {
    display: grid;
    gap: 0.1rem;
  }

  .search-results :global(.search-result) {
    display: block;
    min-width: 0;
    color: var(--foreground);
    padding: 0.65rem 0.75rem;
    border-radius: 0.75rem;
    transition:
      background-color 0.16s var(--ease-out),
      color 0.16s var(--ease-out);
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result:focus-visible) {
    background: var(--muted);
    color: var(--accent);
    outline: none;
  }

  .search-results :global(.search-result__title) {
    display: block;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-result__meta) {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .search-results :global(.search-empty) {
    margin: 0;
    color: var(--muted-foreground);
    padding: 1.75rem 0.75rem;
    font-size: 0.9375rem;
  }

  .search-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    padding: 0.6rem 1rem;
    font-size: 0.7rem;
  }

  .search-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-foot kbd {
    display: inline-grid;
    min-width: 1.2rem;
    height: 1.2rem;
    place-items: center;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--foreground);
    padding: 0 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    border-radius: 0.3rem;
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 639px) {
    .search-dialog {
      padding: 0.75rem;
    }

    .search-field {
      gap: 0.6rem;
      padding: 0 0.85rem;
    }

    .search-input {
      height: 3.5rem;
      font-size: 1rem;
    }

    .search-body {
      max-height: calc(100dvh - 9rem);
    }

    .search-body__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
    }

    .search-foot span:nth-child(-n + 2) {
      display: none;
    }
  }
</style>

---
import ShareButton from "@/components/ShareButton.astro";
import ShareSheet from "@/components/ShareSheet.astro";

/* Closes a story with a way to pass it on, and renders the page's one ShareSheet. */
interface Props {
  title: string;
  /* Absolute URL of the story. */
  url: string;
}

const { title, url } = Astro.props;
---

<section
  hidden
  data-share-card
  aria-labelledby="share-card-title"
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-2xl bg-muted px-6 py-6 md:px-8"
>
  <h2 id="share-card-title" class="headline text-2xl leading-tight">Found this worth reading? Pass it on.</h2>
  <ShareButton title={title} url={url} class="pill-solid pill-lg" />
</section>

<ShareSheet title={title} url={url} />

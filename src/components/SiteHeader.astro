---
import { navigation, siteConfig } from "@/config/site";
import SearchDialog from "@/components/SearchDialog.astro";
import { layoutExamples, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  /* Transparent header laid over an immersive story photo. */
  overlay?: boolean;
}

const { posts, overlay = false } = Astro.props;
const examples = layoutExamples(posts);
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(href);
const dateLocale = siteConfig.locale.replace("_", "-");
---

<header class:list={[overlay ? "site-header--overlay" : "bg-background"]}>
  <div class="mx-auto layout-wide px-5 lg:px-8">
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 py-4 lg:grid-cols-[1fr_auto_1fr] lg:py-6">
      <div class="hidden min-w-0 text-[0.8125rem] leading-snug text-muted-foreground lg:block">
        <time class="block min-h-[1.25em] font-medium text-foreground" data-today></time>
        <p>{siteConfig.tagline}</p>
      </div>

      <div class="min-w-0 justify-self-start lg:justify-self-center">
        <a href="/" class="inline-block" aria-label={`${siteConfig.name} home`}>
          <span class="wordmark">{siteConfig.name}</span>
        </a>
        <time class="mt-1 block min-h-[1.2em] text-xs text-muted-foreground lg:hidden" data-today></time>
      </div>

      <div class="relative flex min-w-0 items-center justify-end gap-1 justify-self-end lg:min-w-72">
        <a href="/search/" class="icon-btn" aria-label="Search stories" aria-haspopup="dialog" data-search-open>
          <svg aria-hidden="true" class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </a>
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch color theme">
          <svg aria-hidden="true" class="theme-icon-sun h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <path
              d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5l-1.5-1.5M20.5 20.5 19 19M19 5l1.5-1.5M3.5 20.5 5 19"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"></circle>
          </svg>
          <svg aria-hidden="true" class="theme-icon-moon h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          type="button"
          class="mobile-menu-toggle icon-btn border border-border lg:hidden"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          aria-label="Open navigation menu"
          data-mobile-menu-toggle
        >
          <svg aria-hidden="true" class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav class="hidden border-y border-border lg:block" aria-label="Primary navigation">
      <ul class="flex items-center justify-center gap-8">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          examples.length > 0 && (
            <li class="relative" data-layouts>
              <button type="button" class="nav-link" aria-expanded="false" aria-controls="layouts-menu" data-layouts-toggle>
                Layouts
                <svg aria-hidden="true" class="layouts-chevron h-3.5 w-3.5" viewBox="0 0 24 24" fill="none">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div id="layouts-menu" class="layouts-menu" hidden data-layouts-menu>
                <ul class="grid gap-0.5">
                  {examples.map((example) => (
                    <li>
                      <a href={example.href} class="layouts-item" aria-current={currentPath === example.href ? "page" : undefined}>
                        <span class="block text-[0.9375rem] font-semibold text-foreground">{example.label}</span>
                        <span class="block text-[0.8125rem] leading-snug text-muted-foreground">{example.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <nav class="border-y border-border lg:hidden" aria-label="Sections">
    <ul class="no-scrollbar flex gap-2 overflow-x-auto px-5 py-2.5">
      {
        navigation.map((item) => (
          <li class="shrink-0">
            <a href={item.href} class="pill" aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<div id="mobile-menu-panel" class="mobile-menu-panel lg:hidden" hidden>
  <div class="flex items-center justify-between gap-6 px-5 py-4">
    <a href="/" class="wordmark" aria-label={`${siteConfig.name} home`}>{siteConfig.name}</a>
    <button type="button" class="icon-btn border border-border" data-mobile-menu-close aria-label="Close navigation menu">
      <svg aria-hidden="true" class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="px-5 pb-8 pt-2">
    <time class="block min-h-[1.25em] text-sm text-muted-foreground" data-today></time>

    <a
      href="/search/"
      class="mt-5 flex h-12 items-center gap-3 rounded-full border border-border bg-card px-4 text-base text-muted-foreground"
      aria-haspopup="dialog"
      data-search-open
    >
      <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      Search stories
    </a>

    <nav class="mt-6" aria-label="Mobile navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between border-b border-border py-4 font-display text-[1.6rem] font-semibold leading-none"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
                <svg aria-hidden="true" class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      examples.length > 0 && (
        <div class="mt-6">
          <h2 class="text-sm font-semibold">Story layouts</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {examples.map((example) => (
              <li>
                <a href={example.href} class="pill">
                  {example.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul class="mt-6 flex flex-wrap gap-2">
      <li><a href="/all-news/" class="pill">All news</a></li>
      <li><a href="/about/" class="pill">About</a></li>
      <li><a href="/contact/" class="pill">Contact</a></li>
    </ul>
  </div>
</div>

<script is:inline define:vars={{ dateLocale }}>
  (() => {
    const now = new Date();
    document.querySelectorAll("[data-today]").forEach((element) => {
      element.textContent = now.toLocaleDateString(dateLocale, {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric",
      });
      element.setAttribute("datetime", now.toISOString().slice(0, 10));
    });
  })();
</script>

<SearchDialog posts={posts} />

<script is:inline>
  const layouts = document.querySelector("[data-layouts]");
  const layoutsToggle = layouts?.querySelector("[data-layouts-toggle]");
  const layoutsMenu = layouts?.querySelector("[data-layouts-menu]");

  if (layouts && layoutsToggle && layoutsMenu) {
    const setLayoutsOpen = (open) => {
      layoutsMenu.hidden = !open;
      layoutsToggle.setAttribute("aria-expanded", String(open));
    };

    layoutsToggle.addEventListener("click", () => {
      setLayoutsOpen(layoutsToggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("click", (event) => {
      if (!layouts.contains(event.target)) setLayoutsOpen(false);
    });

    layouts.addEventListener("focusout", (event) => {
      if (!layouts.contains(event.relatedTarget)) setLayoutsOpen(false);
    });

    layouts.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || layoutsMenu.hidden) return;
      setLayoutsOpen(false);
      layoutsToggle.focus();
    });
  }

  const mobileMenuButton = document.querySelector("[data-mobile-menu-toggle]");
  const mobileMenuPanel = document.getElementById("mobile-menu-panel");

  if (mobileMenuButton && mobileMenuPanel) {
    const mobileMenuClose = mobileMenuPanel.querySelector("[data-mobile-menu-close]");
    const mobileMenuFirstLink = mobileMenuPanel.querySelector("a");

    const setMenuOpen = (open) => {
      mobileMenuPanel.hidden = !open;
      mobileMenuButton.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("has-open-menu", open);

      if (open) {
        window.requestAnimationFrame(() => {
          (mobileMenuClose || mobileMenuFirstLink)?.focus();
        });
      }
    };

    mobileMenuButton.addEventListener("click", () => {
      setMenuOpen(mobileMenuButton.getAttribute("aria-expanded") !== "true");
    });

    mobileMenuPanel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    mobileMenuClose?.addEventListener("click", () => {
      setMenuOpen(false);
      mobileMenuButton.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || mobileMenuPanel.hidden) return;
      setMenuOpen(false);
      mobileMenuButton.focus();
    });
  }
</script>

<style>
  .wordmark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 800;
    font-variation-settings: "opsz" 60;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.85rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted-foreground);
    transition: color 0.2s ease;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    content: "";
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--foreground);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .layouts-chevron {
    transition: transform 0.2s ease;
  }

  [aria-expanded="true"] > .layouts-chevron {
    transform: rotate(180deg);
  }

  .layouts-menu {
    position: absolute;
    top: calc(100% + 1px);
    left: 50%;
    z-index: 40;
    width: 20rem;
    transform: translateX(-50%);
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 1.25rem 1.25rem;
    background: var(--card);
    padding: 0.5rem;
    box-shadow: 0 24px 60px -20px oklch(0 0 0 / 30%);
    color: var(--foreground);
  }

  .layouts-menu[hidden] {
    display: none;
  }

  .layouts-item {
    display: block;
    border-radius: 0.875rem;
    padding: 0.65rem 0.85rem;
    transition: background-color 0.2s ease;
  }

  .layouts-item:hover,
  .layouts-item:focus-visible,
  .layouts-item[aria-current="page"] {
    background: var(--muted);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 30;
    color: #fff;
    background: linear-gradient(to bottom, oklch(0 0 0 / 55%), transparent);
  }

  .site-header--overlay .text-muted-foreground {
    color: rgb(255 255 255 / 75%);
  }

  .site-header--overlay .text-foreground,
  .site-header--overlay .icon-btn,
  .site-header--overlay .nav-link[aria-current="page"],
  .site-header--overlay .nav-link:hover {
    color: #fff;
  }

  .site-header--overlay .nav-link {
    color: rgb(255 255 255 / 80%);
  }

  .site-header--overlay .border-border {
    border-color: rgb(255 255 255 / 22%);
  }

  .site-header--overlay .icon-btn:hover {
    background: rgb(255 255 255 / 15%);
  }

  .site-header--overlay .pill {
    border-color: rgb(255 255 255 / 30%);
    color: #fff;
  }

  .site-header--overlay .pill[aria-current="page"] {
    border-color: #fff;
    background: #fff;
    color: oklch(0.19 0.01 60);
  }

  .site-header--overlay .layouts-menu .text-foreground {
    color: var(--foreground);
  }

  .site-header--overlay .layouts-menu .text-muted-foreground {
    color: var(--muted-foreground);
  }

  .no-scrollbar {
    scrollbar-width: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .mobile-menu-panel {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--background);
  }

  .mobile-menu-panel[hidden] {
    display: none;
  }

</style>

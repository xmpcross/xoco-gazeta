---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="grid min-h-[60vh] place-items-center px-5 py-16 text-center">
    <div>
      <p class="font-display text-7xl font-bold text-accent">404</p>
      <h1 class="headline mt-4 text-[clamp(2.25rem,5vw,3.25rem)]">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-muted-foreground">That story may have moved, or the address may be mistyped.</p>
      <a href="/" class="pill pill-solid pill-lg mt-8">Back to the front page</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

---
import { getCollection } from "astro:content";
import LocalIcon from "@/components/LocalIcon.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const contact = siteConfig.contact;
const enabled = Boolean(contact.action);
const desks = [
  { title: "News tips", text: "Documents, leads, and stories we should be covering." },
  { title: "Corrections", text: "Reviewed by an editor and noted on the story." },
  { title: "Advertising", text: "Sponsorships, newsletter placements, and partnerships." },
];
const socialIconByLabel = {
  Instagram: "instagram",
  TikTok: "tiktok",
  YouTube: "youtube",
  RSS: "rss",
} as const;
const socials = siteConfig.socials
  .filter((item) => item.label !== "RSS")
  .map((item) => ({ ...item, icon: socialIconByLabel[item.label as keyof typeof socialIconByLabel] ?? "link-45deg" }));
---

<BaseLayout title="Contact" description={`Contact ${siteConfig.name} for news tips, corrections, advertising, and general inquiries.`}>
  <SiteHeader posts={allPosts} />
  <main id="content">
    <section class="mx-auto layout-wide px-5 pt-10 lg:px-8 lg:pt-14">
      <h1 class="headline text-[clamp(2.75rem,6vw,4.5rem)] leading-none">Get in touch</h1>
      <p class="mt-5 max-w-2xl text-pretty font-display text-[1.25rem] leading-relaxed text-muted-foreground">
        Tips, corrections, partnerships, or a note about a story. Every message is read by a person on the desk.
      </p>
    </section>

    <section class="mx-auto layout-wide px-5 pt-10 lg:px-8 lg:pt-12">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-14">
        <form
          class="rounded-3xl border border-border bg-card p-6 md:p-10"
          action={contact.action || undefined}
          method={contact.method}
          aria-describedby={enabled ? undefined : "contact-form-note"}
        >
          <fieldset class="grid gap-5 sm:grid-cols-2" disabled={!enabled}>
            <legend class="sr-only">Send us a message</legend>
            <div class="grid gap-2">
              <label for="contact-name" class="form-label">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required class="input" />
            </div>
            <div class="grid gap-2">
              <label for="contact-email" class="form-label">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required class="input" />
            </div>
            <div class="grid gap-2 sm:col-span-2">
              <label for="contact-topic" class="form-label">Topic</label>
              <div class="relative">
                <select id="contact-topic" name="topic" class="input appearance-none pr-10">
                  {contact.topics.map((topic) => <option>{topic}</option>)}
                </select>
                <svg aria-hidden="true" class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>
            <div class="grid gap-2 sm:col-span-2">
              <label for="contact-message" class="form-label">Message</label>
              <textarea id="contact-message" name="message" rows="7" required class="input resize-y py-3"></textarea>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2">
              <p class="meta">{contact.responseTime}</p>
              <button type="submit" class="pill pill-solid pill-lg disabled:pointer-events-none disabled:opacity-50">
                Send message
              </button>
            </div>
          </fieldset>
          {
            !enabled && (
              <p id="contact-form-note" class="mt-6 rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground">
                This form is a starter. Set <code class="font-medium text-foreground">contact.action</code> in{" "}
                <code class="font-medium text-foreground">src/config/site.ts</code> to your form endpoint to switch it on, or
                email <a href={`mailto:${siteConfig.email}`} class="text-foreground underline underline-offset-4">{siteConfig.email}</a>.
              </p>
            )
          }
        </form>

        <aside class="grid content-start gap-8" aria-label="Contact details">
          <div>
            <h2 class="text-sm font-semibold">Email</h2>
            <a href={`mailto:${siteConfig.email}`} class="headline mt-1.5 inline-block text-[1.35rem] hover:text-accent">
              {siteConfig.email}
            </a>
          </div>
          <div>
            <h2 class="text-sm font-semibold">Phone</h2>
            <a href={`tel:${contact.phone.replace(/\s+/g, "")}`} class="headline mt-1.5 inline-block text-[1.35rem] hover:text-accent">
              {contact.phone}
            </a>
          </div>
          <div>
            <h2 class="text-sm font-semibold">Newsroom</h2>
            <address class="mt-1.5 not-italic leading-relaxed text-muted-foreground">
              {contact.address.map((line) => <span class="block">{line}</span>)}
            </address>
          </div>
          <ul class="grid gap-4 border-y border-border py-6">
            {
              desks.map((desk) => (
                <li>
                  <p class="font-display text-lg font-semibold leading-tight">{desk.title}</p>
                  <p class="mt-1 text-sm text-muted-foreground">{desk.text}</p>
                </li>
              ))
            }
          </ul>
          {
            socials.length > 0 && (
              <div>
                <h2 class="text-sm font-semibold">Follow along</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {socials.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="inline-grid h-10 w-10 place-items-center rounded-full border border-border text-muted-foreground transition-colors hover:border-foreground hover:text-foreground"
                        aria-label={`${siteConfig.name} on ${item.label}`}
                        rel="noreferrer"
                      >
                        <LocalIcon name={item.icon} className="h-4 w-4" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .input {
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    background: var(--background);
    color: var(--foreground);
    padding: 0.65rem 1rem;
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .input:focus {
    border-color: var(--foreground);
    outline: none;
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  fieldset:disabled .input {
    cursor: not-allowed;
    opacity: 0.7;
  }
</style>
